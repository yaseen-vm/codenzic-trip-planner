# Native Google Maps SDK keys (restrict to app identifiers and Maps SDK APIs).
GOOGLE_MAPS_ANDROID_API_KEY=replace_with_android_key
GOOGLE_MAPS_IOS_API_KEY=replace_with_ios_key

# Separate Google Places API (New) key for autocomplete and Routes API key for routing.
# EXPO_PUBLIC values are bundled into the mobile app; use only restricted keys.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=replace_with_places_key
EXPO_PUBLIC_GOOGLE_ROUTES_API_KEY=replace_with_routes_key
