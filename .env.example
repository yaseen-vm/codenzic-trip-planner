# Native Maps SDK keys only. Restrict by app identity and Maps SDK. Do not reuse Places/Routes keys.
GOOGLE_MAPS_ANDROID_API_KEY=replace_with_android_key
GOOGLE_MAPS_IOS_API_KEY=replace_with_ios_key

# Separate Places API (New) and Routes API keys.
# EXPO_PUBLIC values are bundled into the app; restrict API scope and use a backend proxy in production.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=replace_with_places_key
EXPO_PUBLIC_GOOGLE_ROUTES_API_KEY=replace_with_routes_key
